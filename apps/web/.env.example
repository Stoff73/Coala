# Copy to .env and fill in what you need. Read server-side only (PLAN §6b).

# --- Database (Prisma) ---
# SQLite for local dev. For production, switch schema.prisma `provider` to
# "postgresql" and point this at your Postgres instance.
DATABASE_URL="file:./dev.db"

# --- LLM providers (BYO-key) ---

# Anthropic / Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# xAI (Grok)
XAI_API_KEY=
# XAI_BASE_URL=

# Google Gemini
GOOGLE_API_KEY=

# Ollama (local; usually no key)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Generic local / self-hosted OpenAI-compatible endpoint
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_API_KEY=
