{
  "name": "coala-agent-builder",
  "version": "0.0.0",
  "private": true,
  "description": "Visual application for designing language agents on the CoALA framework",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=18"
  }
}
